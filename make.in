# -*- mode:makefile; -*-

# COMPILER AND COMPILER FLAGS
CXX?=g++

# Set compiler-specific flags
ifeq ($(CXX),g++)
    CXXFLAGS_SPECIFIC=-g -O3 -ftracer -floop-optimize -funroll-loops
else ifeq ($(CXX),clang++)
    CXXFLAGS_SPECIFIC=-g -O3 -funroll-loops -flto
else
    CXXFLAGS_SPECIFIC=-g -O3
endif

CXXFLAGS=$(CXXFLAGS_SPECIFIC)

# AUTOMATIC DEPENDENCY GENERATION
MAKEDEPEND=g++ -M $(CXXFLAGS)

# INCLUDES AND LINKER FLAGS
# Lapack includes and linking

ILAPACK=
LLAPACK=

ifeq ($(shell uname -s),Darwin)
    LLAPACK=-framework Accelerate
else
    LLAPACK=-lopenblas
endif


TBSRC=../libs/
LDFLAGS=-L$(TBSRC) -ltoolbox $(LLAPACK)
CXXFLAGS:=$(CXXFLAGS) -I$(TBSRC) $(ILAPACK)
